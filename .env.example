# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account json key file (optional if using GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Set to true to use local Firestore emulator (e.g. localhost:8080)
USE_FIRESTORE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080

# Embedding Provider: 'openai', 'gemini', or 'mock' (for offline testing)
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
MCP_SERVER_NAME=mcp-las
MCP_SERVER_PORT=8000
